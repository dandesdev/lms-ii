# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Liveblocks (https://liveblocks.io/dashboard)
LIVEBLOCKS_SECRET_KEY=sk_live_...
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_live_...

# Superuser — this email gets role=superuser on signup/login and controls invites.
# Every other teacher must join through an invite link.
SUPERUSER_EMAIL=your-email@example.com

# App URL (for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Usage alert emails (optional — alerts still show in /admin/usage without these)
RESEND_API_KEY=re_...
ALERT_EMAIL_FROM=LMS Alerts <alerts@yourdomain.com>

# Shared secret for the scheduled usage recompute (Vercel Cron sends it automatically)
CRON_SECRET=generate-a-long-random-string

# Backend free-tier ceilings used by the superuser alerts (bytes / counts).
# Defaults match the Supabase + Liveblocks free tiers.
BACKEND_DB_LIMIT_BYTES=524288000
BACKEND_STORAGE_LIMIT_BYTES=1073741824
BACKEND_LIVEBLOCKS_MAU_LIMIT=100
